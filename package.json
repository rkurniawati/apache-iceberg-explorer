{
  "name": "iceberg-explorer",
  "displayName": "Iceberg Explorer",
  "description": "Browse Apache Iceberg warehouses in Google Cloud Storage, S3-compatible storage, or local file system from VS Code.",
  "icon": "resources/iceberg.png",
  "version": "0.0.1",
  "publisher": "RuthK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rkurniawati/apache-iceberg-explorer.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "iceberg",
    "apache iceberg",
    "data lakehouse",
    "parquet",
    "duckdb",
    "s3",
    "gcs",
    "sql",
    "metadata"
  ],
  "bugs": {
    "url": "https://github.com/rkurniawati/apache-iceberg-explorer/issues"
  },
  "homepage": "https://github.com/rkurniawati/apache-iceberg-explorer#readme",
  "activationEvents": [
    "onView:icebergExplorer",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "icebergExplorer",
          "name": "Iceberg Explorer",
          "icon": "resources/iceberg.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "icebergExplorer.openSettings",
        "title": "Add Connection",
        "category": "Iceberg Explorer",
        "icon": "$(plus)"
      },
      {
        "command": "icebergExplorer.connectConnection",
        "title": "Connect",
        "category": "Iceberg Explorer"
      },
      {
        "command": "icebergExplorer.disconnectConnection",
        "title": "Disconnect",
        "category": "Iceberg Explorer"
      },
      {
        "command": "icebergExplorer.editConnection",
        "title": "Edit Connection",
        "category": "Iceberg Explorer"
      },
      {
        "command": "icebergExplorer.deleteConnection",
        "title": "Delete Connection",
        "category": "Iceberg Explorer"
      },
      {
        "command": "icebergExplorer.openTableOverview",
        "title": "Open Table Overview",
        "category": "Iceberg Explorer"
      },
      {
        "command": "icebergExplorer.openSchemaOverview",
        "title": "Open Schema Overview",
        "category": "Iceberg Explorer"
      },
      {
        "command": "icebergExplorer.openConnectionDashboard",
        "title": "Open Connection Dashboard",
        "category": "Iceberg Explorer"
      },
      {
        "command": "icebergExplorer.openMetadataStructure",
        "title": "Open Metadata Structure",
        "category": "Iceberg Explorer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "icebergExplorer.openSettings",
          "when": "view == icebergExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "icebergExplorer.connectConnection",
          "when": "view == icebergExplorer && (viewItem == icebergConnection || viewItem == icebergConnectionDisconnected)",
          "group": "icebergConnection@1"
        },
        {
          "command": "icebergExplorer.disconnectConnection",
          "when": "view == icebergExplorer && viewItem == icebergConnectionConnected",
          "group": "icebergConnection@1"
        },
        {
          "command": "icebergExplorer.editConnection",
          "when": "view == icebergExplorer && (viewItem == icebergConnection || viewItem == icebergConnectionConnected || viewItem == icebergConnectionDisconnected)",
          "group": "icebergConnection@2"
        },
        {
          "command": "icebergExplorer.deleteConnection",
          "when": "view == icebergExplorer && (viewItem == icebergConnection || viewItem == icebergConnectionConnected || viewItem == icebergConnectionDisconnected)",
          "group": "icebergConnection@3"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "icebergExplorer",
        "contents": "Loading Iceberg Explorer...",
        "when": "!icebergExplorer.initialized"
      },
      {
        "view": "icebergExplorer",
        "contents": "No Iceberg connections configured.\n[Add Connection](command:icebergExplorer.openSettings)\n\nConfigure a connection to local, S3-compatible, or Google Cloud Storage Iceberg tables.",
        "when": "icebergExplorer.initialized"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run bundle",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "bundle:prod": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify --sourcemap && node scripts/bundle-duckdb.mjs --minify",
    "copy-wasm": "node scripts/bundle-duckdb.mjs",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "npm run test:slice && npm run test:slice-settings && npm run test:slice-query && npm run test:slice-tree && npm run test:slice-panels && npm run test:slice-new-panels && npm run test:slice-gcs && npm run test:slice-view && npm run test:slice-location",
    "test:slice": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-metadata-panel.test.ts",
    "test:slice-settings": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-settings-panel.test.ts",
    "test:slice-query": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-query-engine.test.ts",
    "test:slice-tree": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-tree-view.test.ts",
    "test:slice-panels": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-manifest-panels.test.ts",
    "test:slice-new-panels": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-new-panels.test.ts",
    "test:slice-gcs": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-gcs.test.ts",
    "test:slice-view": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-iceberg-view.test.ts",
    "test:slice-location": "npx ts-node -P tsconfig.test.json -r ./test-setup.ts src/test/slice-location-resolver.test.ts",
    "vscode:prepublish": "npm run compile && npm run bundle:prod",
    "package": "vsce package",
    "release": "node scripts/release.mjs",
    "generate-icon": "inkscape resources/iceberg.svg -w 256 -h 256 -o resources/iceberg.png",
    "postcompile": "npm run copy-wasm"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@duckdb/duckdb-wasm": "^1.29.0",
    "@google-cloud/storage": "^8.2.0",
    "avsc": "^5.7.7",
    "pgsql-ast-parser": "^12.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^4.0.0",
    "apache-arrow": "^17.0.0",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
